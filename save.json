      "speaker": "character_3940b014c1",
      "text": "Filename: ai_generated_video_20250314_2142.mp4\nLocation: West Entrance - Stakes Building\nDate: March 14, 2025\nTime: 9:42 PM",
      "options": [
        {
          "text": "Wait, that's AI generated.",
          "nextNodeId": "node_7a33d60193"
        },
        {
          "text": "Where is this from?",
