    "node_39e80ef550": {
      "id": "node_39e80ef550",
      "speaker": "prosecutor",
      "text": "The prosecution calls Mr. Wilson, who was present in the building on the night of the attack.",
      "options": [],
      "position": {
        "x": 1426,
        "y": 361
      },
      "nextNodeId": "node_c70ac3cd44"
    },
    "node_c70ac3cd44": {
      "id": "node_c70ac3cd44",
      "speaker": "character_acaf30b3c9",
      "text": "I heard this angry, panicked man screaming from Room 501, like he had completely lost control. He was yelling horrible threats, followed by a loud crash that made the whole wall shake.",
      "options": [],
      "position": {
        "x": 1849,
        "y": 358
      },
      "nextNodeId": "node_d56a0fb6b9"
    },
    "node_6263a058f6": {
      "id": "node_6263a058f6",
      "speaker": "judge",
      "text": "The claim of muteness is not supported by the defendant's own testimony. It will be disregarded.",
      "options": [],
      "position": {
        "x": 3416,
        "y": 217
      },
      "nextNodeId": "node_7d3b114e83"
    },
    "node_cbb14d6e91": {
      "id": "node_cbb14d6e91",
      "speaker": "judge",
      "text": "And there it is again. The defendant continues to speak.",
      "options": [],
      "position": {
        "x": 3414,
        "y": 410
      },
      "nextNodeId": "node_447274a208"
    },
    "node_447274a208": {
      "id": "node_447274a208",
      "speaker": "judge",
      "text": "The claim is rejected.",
      "options": [],
      "position": {
        "x": 3808,
        "y": 509
      },
      "nextNodeId": "node_7d3b114e83"
    },
    "node_cf10e5fab7": {
      "id": "node_cf10e5fab7",
      "speaker": "judge",
      "text": "The defendant has been verbally answering questions throughout the proceedings. Continued silence does not make the claim credible.",
